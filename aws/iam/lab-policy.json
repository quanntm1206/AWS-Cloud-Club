{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProjectArtifact",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_PROJECT_BUCKET/models/*"
    },
    {
      "Sid": "WriteFunctionLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:REPLACE_ACCOUNT_ID:log-group:/aws/lambda/ml-roadmap-REPLACE_PROJECT_ID:*"
    }
  ]
}

